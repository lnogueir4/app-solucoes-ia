# Chaves de API do app Soluções de IA.
# Copie este arquivo para .env (na mesma pasta) e preencha só os provedores que for usar.
# O .env fica fora do controle de versão (.gitignore). Nunca publique esse arquivo.

# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com
GEMINI_API_KEY=

# Compatível com OpenAI (OpenRouter e outros). Ollama e LM Studio não precisam de chave.
OPENAI_COMPAT_API_KEY=
